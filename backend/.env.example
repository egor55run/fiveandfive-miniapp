# Copy to .env and adjust. For local docker-compose the defaults below work as-is.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fiveandfive?schema=public"
PORT=3000

# ── Telegram Mini App ────────────────────────────────────────────────────────
# Токен бота из @BotFather. Нужен для проверки подписи initData.
# СЕКРЕТ: только в .env (он в .gitignore), никогда в этот файл и не в коммит.
BOT_TOKEN=""

# Прод обязан выставлять NODE_ENV=production — этим отключается dev-обход ниже.
# NODE_ENV=production

# Локальная разработка вне Telegram: если задать telegram id, запросы без
# заголовка Authorization будут авторизованы как этот фейковый пользователь.
# Работает ТОЛЬКО при NODE_ENV != production, поэтому в проде недостижимо.
# DEV_AUTH_TELEGRAM_ID=123456789
# DEV_AUTH_FIRST_NAME=Егор
# DEV_AUTH_LAST_NAME=Кадиров
# DEV_AUTH_USERNAME=dev_user
