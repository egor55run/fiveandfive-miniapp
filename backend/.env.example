# Copy to .env and adjust. For local docker-compose the defaults below work as-is.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fiveandfive?schema=public"
PORT=3000

# ── Telegram Mini App ────────────────────────────────────────────────────────
# Токен бота из @BotFather. Нужен для проверки подписи initData.
# СЕКРЕТ: только в .env (он в .gitignore), никогда в этот файл и не в коммит.
BOT_TOKEN=""

# Прод обязан выставлять NODE_ENV=production — этим отключается dev-обход ниже.
# NODE_ENV=production

# ── Админка /admin ───────────────────────────────────────────────────────────
# Кому разрешён вход. Список telegram_id через запятую.
# Пароля в системе нет: личность подтверждает Telegram (Login Widget в браузере
# или initData внутри Telegram), а этот список решает, кто из них администратор.
# Держим здесь, а не в БД: компрометация базы не даёт админских прав.
# Пусто или не задано -> вход в админку закрыт для всех (fail-closed).
ADMIN_TELEGRAM_IDS=""

# ── Уведомления участникам ───────────────────────────────────────────────────
# Отправляются тем же BOT_TOKEN через Bot API (sendMessage): регистрация,
# результат, напоминание за 3 дня. Помни ограничение платформы: бот не может
# написать первым тому, кто не открывал с ним диалог, — такие попытки уходят в
# журнал notifications со статусом BLOCKED (403) или FAILED (400 chat not found).
#
# Не задано -> включено только при NODE_ENV=production. То есть локальная
# разработка по умолчанию никому не пишет, а прод работает без лишней настройки.
# Явное значение сильнее: "false" глушит рассылку и в проде.
# NOTIFY_ENABLED=true
#
# Ссылка «подробнее в приложении» внутри сообщений.
APP_URL="https://fiveandfive.kz"

# ── Оплата: счёт в Kaspi через ApiPay.kz ─────────────────────────────────────
# Ключ из личного кабинета ApiPay (Настройки → API). СЕКРЕТ: только в .env.
# Не задан -> оплата выключена: регистрации создаются со статусом PENDING без
# счёта (прежняя заглушка). Удобно для локальной разработки.
# APIPAY_API_KEY=""
#
# Секрет подписи вебхуков (в кабинете ApiPay рядом с webhook_url). Без него
# вебхуки отклоняются, и оплата подтверждается только опросом статуса.
# В кабинете ApiPay указать webhook URL:
#   https://fiveandfive.kz/api/payments/apipay/webhook
# APIPAY_WEBHOOK_SECRET=""
#
# Адрес API. Песочница и боевой режим переключаются в кабинете ApiPay, ключ тот же.
# APIPAY_BASE_URL="https://api.apipay.kz/api/v1"
#
# Сколько минут держим место за неоплаченной регистрацией (минимум 5).
# PAYMENT_TTL_MINUTES=30
#
# Фоновая сверка оплат раз в минуту (освобождает места по просроченным счетам).
# PAYMENTS_SWEEP=true

# ── Загруженные файлы (карты трасс) ──────────────────────────────────────────
# Куда админка кладёт картинки карт. Не задано -> backend/uploads (каталог в
# .gitignore, а `git reset --hard` в деплой-скрипте untracked-файлы не удаляет,
# так что загруженные карты переживают деплой). Если каталог переносится наружу,
# он должен существовать и быть доступен на запись пользователю, под которым
# живёт pm2. Раздаёт файлы сам бэкенд на /uploads/ — снаружи это /api/uploads/.
# UPLOAD_DIR=/var/lib/fiveandfive/uploads

# Локальная разработка вне Telegram: если задать telegram id, запросы без
# заголовка Authorization будут авторизованы как этот фейковый пользователь.
# Работает ТОЛЬКО при NODE_ENV != production, поэтому в проде недостижимо.
# DEV_AUTH_TELEGRAM_ID=123456789
# DEV_AUTH_FIRST_NAME=Егор
# DEV_AUTH_LAST_NAME=Кадиров
# DEV_AUTH_USERNAME=dev_user
