generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id         Int       @id @default(autoincrement())
  // Личность из подписанного Telegram initData — основной идентификатор.
  // Nullable только ради legacy-строк, созданных до Mini App: весь новый код
  // (plugins/telegramAuth.ts) заводит пользователя исключительно по нему.
  telegramId BigInt?   @unique @map("telegram_id")
  username   String?
  firstName  String    @map("first_name")
  lastName   String?   @map("last_name")
  // email/age/phone заполняются не при входе, а при регистрации на старт,
  // поэтому опциональны. @unique с email снят: идентификатор теперь telegram_id,
  // и два Telegram-аккаунта вправе указать один и тот же email.
  email      String?
  // Возраст держим рядом с датой рождения, а не вместо неё: он нужен протоколам
  // и возрастным группам, но сам по себе устаревает. Когда известна дата,
  // сервер пересчитывает age из неё, чтобы эти два поля не разошлись.
  age        Int?
  // Только дата, без времени и часового пояса: @db.Date. DateTime здесь сдвинул
  // бы день на границе TZ — 14.12.1999 в Алматы стало бы 13-м в UTC.
  birthDate  DateTime? @map("birth_date") @db.Date
  phone      String?
  // Пол из формы регистрации — подставляется в следующую, как дата рождения.
  // Пригодится и для зачёта «среди мужчин/женщин». Nullable: у записей,
  // сделанных до этого поля, пола нет.
  gender     Gender?
  createdAt  DateTime  @default(now()) @map("created_at")

  registrations    Registration[]
  results          Result[]
  seasonPasses     SeasonPass[]
  notifications    Notification[]
  emails           EmailNotification[]
  payments         Payment[]
  consents         Consent[]
  refunds          Refund[]
  promoRedemptions PromoRedemption[]

  @@map("users")
}

model Season {
  id            Int       @id @default(autoincrement())
  title         String
  year          Int
  price         Decimal   @default(0) @db.Decimal(10, 2)
  isActive      Boolean   @default(false) @map("is_active")
  /// Когда закрывается продажа абонемента. null — вместе с регистрацией на
  /// первый старт сезона (lib/seasonPass). Задаётся в админке.
  salesClosesAt DateTime? @map("sales_closes_at")
  /// Стартовые номера абонементов: один номер на весь сезон, из этого
  /// диапазона. Диапазоны дистанций стартов с ним не пересекаются (админка).
  passBibFrom   Int?      @map("pass_bib_from")
  passBibTo     Int?      @map("pass_bib_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  events       Event[]
  seasonPasses SeasonPass[]

  @@map("seasons")
}

model Event {
  id                   Int       @id @default(autoincrement())
  title                String
  /// Адрес страницы старта на сайте: /starty/<slug>. Латиницей, с годом
  /// («triatlon-park-astana-2027»), чтобы старты следующих сезонов в тех же
  /// парках получили свои адреса. Пустой — сервер заполнит при запуске (lib/slug).
  slug                 String?   @unique
  date                 DateTime
  /// Когда закрывается регистрация. null — по умолчанию за 7 дней до старта
  /// (lib/eligibility). Задаётся в админке, если нужно иначе.
  registrationClosesAt DateTime? @map("registration_closes_at")
  location             String
  distance             String
  slotsTotal           Int       @map("slots_total")
  slotsTaken           Int       @default(0) @map("slots_taken")
  price                Decimal   @default(0) @db.Decimal(10, 2)
  seasonId             Int?      @map("season_id")
  /// Карта трассы: путь относительно корня API — «/uploads/routes/<файл>».
  /// Не абсолютный URL осознанно: одно и то же значение работает и локально
  /// (localhost:3000), и в проде, где nginx проксирует /api/ на бэкенд.
  /// Сам файл лежит на диске (UPLOAD_DIR, см. lib/routeImages.ts), в БД только
  /// ссылка. null — карты у старта нет, приложение покажет плейсхолдер.
  routeImageUrl        String?   @map("route_image_url")
  /// Программа дня (выдача пакетов, разминка, старт, награждение) — текст
  /// из админки, по строке на пункт. Показывается на странице старта.
  program              String?
  /// Положение о забеге — PDF, загруженный в админке: путь вида
  /// «/uploads/regulations/event-1-a3f9c1d2.pdf» (как у карты трассы).
  regulationsUrl       String?   @map("regulations_url")
  /// Где и когда основная выдача стартовых пакетов (за 2 и за 1 день до
  /// старта) — текст из админки. null — «[время и место уточняются]».
  /// Комментарий к выдаче пакетов (раньше — «время и место» одной строкой).
  packetPickupInfo     String?   @map("packet_pickup_info")
  /// Где выдаём стартовые пакеты: название места и адрес. Даты и часы — pickup_slots.
  pickupPlace          String?   @map("pickup_place")
  pickupAddress        String?   @map("pickup_address")
  /// Оформление старта в Mini App: фон, логотип (пути /uploads/…), акцентный цвет #RRGGBB.
  themeBgUrl           String?   @map("theme_bg_url")
  themeLogoUrl         String?   @map("theme_logo_url")
  themeAccent          String?   @map("theme_accent")
  createdAt            DateTime  @default(now()) @map("created_at")

  season        Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  distances     EventDistance[]
  routeMaps     RouteMap[]
  announcements RaceAnnouncement[]
  pickupSlots   PickupSlot[]
  bibReserves   BibReserve[]
  promoCodes    PromoCode[]
  registrations Registration[]
  results       Result[]
  notifications Notification[]
  emails        EmailNotification[]

  @@map("events")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Registration {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  eventId       Int           @map("event_id")
  seasonPassId  Int?          @map("season_pass_id")
  /// Выбранная дистанция. null — только у старых отменённых записей, чья
  /// дистанция удалена из старта; у живых регистраций всегда есть.
  distanceId    Int?          @map("distance_id")
  /// Добавлен администратором без оплаты (партнёр, волонтёр): занимает место,
  /// считается подтверждённым (PAID), но платежа нет — в деньгах не считается.
  manual        Boolean       @default(false)
  /// Кто это, со слов администратора: «партнёр», «волонтёр»…
  manualNote    String?       @map("manual_note")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  /// Стартовый номер. Выдаётся при оплате (lib/bibs), уникален в пределах
  /// старта. У абонемента — номер абонемента. После начала выдачи пакетов
  /// отмена и возврат номер не освобождают.
  bibNumber     Int?          @map("bib_number")
  /// Оформлен возврат (из админки или по вебхуку ApiPay): запись CANCELLED,
  /// место освобождено, в списке — «Возврат». Сбрасывается, если человек
  /// записался заново. Суммы — в refunds.
  refundedAt    DateTime?     @map("refunded_at")
  qrCode        String?       @map("qr_code")
  registeredAt  DateTime      @default(now()) @map("registered_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seasonPass SeasonPass?    @relation(fields: [seasonPassId], references: [id], onDelete: SetNull)
  distance   EventDistance? @relation(fields: [distanceId], references: [id], onDelete: SetNull)
  payments   Payment[]
  consents   Consent[]
  refunds    Refund[]

  // Один пользователь — одна регистрация на конкретный старт
  @@unique([userId, eventId])
  @@unique([eventId, bibNumber])
  @@map("registrations")
}

/// Дистанция старта (5 км, 3 км…): свой лимит мест, счётчик занятых и цена.
/// Места занимаются и освобождаются только здесь (lib/distances.ts), а поля
/// старта distance / slotsTotal / slotsTaken / price — сводка по дистанциям,
/// которую lib/distances пересчитывает после каждого изменения.
model EventDistance {
  id         Int      @id @default(autoincrement())
  eventId    Int      @map("event_id")
  label      String // «5 км»
  slotsTotal Int      @map("slots_total")
  slotsTaken Int      @default(0) @map("slots_taken")
  price      Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder  Int      @default(0) @map("sort_order")
  /// На эту дистанцию записывает абонемент сезона (одна на старт; пока 5 км).
  seasonPass Boolean  @default(false) @map("season_pass")
  /// Дистанция из справочника (3 км, 5 км…): по ней фильтруются результаты.
  catalogId  Int      @map("catalog_id")
  /// Стартовые номера этой дистанции: выдаются по порядку с bibFrom.
  bibFrom    Int?     @map("bib_from")
  bibTo      Int?     @map("bib_to")
  createdAt  DateTime @default(now()) @map("created_at")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  catalog       Distance       @relation(fields: [catalogId], references: [id])
  registrations Registration[]
  results       Result[]

  @@unique([eventId, label])
  @@index([eventId])
  @@map("event_distances")
}

/// Карта трассы старта. Их может быть несколько («5 км», «3 км»): листаются
/// свайпом. Event.routeImageUrl — первая по порядку (для превью и старых
/// клиентов), её поддерживает lib/routeMaps.
model RouteMap {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  /// Путь относительно корня API: «/uploads/routes/<файл>» (lib/routeImages).
  url       String
  caption   String   @default("")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_route_maps")
}

model SeasonPass {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  seasonId      Int           @map("season_id")
  price         Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  /// Возврат за весь абонемент (все оставшиеся этапы): абонемент CANCELLED.
  refundedAt    DateTime?     @map("refunded_at")
  /// Один стартовый номер на весь сезон (Season.passBibFrom..passBibTo).
  bibNumber     Int?          @map("bib_number")
  createdAt     DateTime      @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  registrations Registration[]
  payments      Payment[]
  consents      Consent[]
  refunds       Refund[]

  // Один абонемент на сезон на пользователя
  @@unique([userId, seasonId])
  @@unique([seasonId, bibNumber])
  @@map("season_passes")
}

model Result {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  eventId         Int      @map("event_id")
  finishTime      Int      @map("finish_time") // финишное время в секундах
  place           Int // место в общем зачёте
  /// Дистанция результата (из регистрации) — для протоколов и рейтинга по дистанциям.
  eventDistanceId Int?     @map("event_distance_id")
  recordedAt      DateTime @default(now()) @map("recorded_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDistance EventDistance? @relation(fields: [eventDistanceId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@map("results")
}

enum NotificationKind {
  /// Регистрация на один старт принята.
  REGISTERED
  /// Напоминание накануне старта (Telegram и письмо).
  RACE_DAY_BEFORE
  /// Оформлен абонемент на сезон — одно сообщение на все старты.
  SEASON_PASS
  /// Организатор внёс результат.
  RESULT
  /// Напоминание за 3 дня до старта.
  RACE_REMINDER
}

enum NotificationStatus {
  SENT
  /// 403 от Telegram: пользователь не начинал диалог с ботом или заблокировал его.
  /// Не ошибка сервера — писать первым бот не имеет права, и повторы не помогут.
  BLOCKED
  /// Сеть, 5xx, таймаут. Напоминания такие попытки повторят на следующий день.
  FAILED
  /// Отправка выключена (NOTIFY_ENABLED) или у пользователя нет telegram_id.
  SKIPPED
}

/// Журнал уведомлений: и защита от повторной отправки, и единственное место, где
/// видно, до кого сообщение не дошло.
///
/// Ключ (user, event, kind) уникален, а строки пишутся через upsert — то есть
/// здесь лежит последняя попытка каждого вида, а не вся история. Так напоминание
/// нельзя отправить дважды, но повторное сообщение о ИСПРАВЛЕННОМ результате
/// отправить можно: оно просто перезапишет свою строку.
model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  /// null у SEASON_PASS: сообщение относится к сезону, а не к одному старту.
  eventId   Int?               @map("event_id")
  kind      NotificationKind
  status    NotificationStatus
  /// Текст отказа от Telegram — чтобы разбираться, не читая логи pm2.
  error     String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, kind])
  @@map("notifications")
}

/// Письма участникам (Brevo, lib/email). Те же события, что у бота:
/// регистрация/оплата, абонемент, напоминание накануне. Одно письмо на
/// событие: SENT повторно не отправляется. QUEUED — ждёт лимита (300 в день на
/// бесплатном тарифе Brevo): его отправит очередь, текст лежит здесь же и
/// стирается после отправки.
model EmailNotification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  /// null — у абонемента (письмо про сезон целиком) и у тестовых писем.
  eventId   Int?             @map("event_id")
  kind      NotificationKind
  /// Кому ушло — адрес мог поменяться с тех пор.
  to        String
  status    String // SENT / QUEUED / FAILED
  error     String?
  /// Письмо целиком — пока оно в очереди (после отправки стирается).
  subject   String?
  html      String?
  text      String?
  attempts  Int              @default(0)
  sentAt    DateTime?        @map("sent_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, eventId, kind])
  @@map("email_notifications")
}

/// Сессия администратора в /admin. Пароля в системе нет: личность подтверждает
/// Telegram (Login Widget в браузере или initData внутри Telegram), а дальше
/// живёт эта сессия — её, в отличие от JWT, можно отозвать.
model AdminSession {
  id         Int      @id @default(autoincrement())
  // Только sha256 от токена: дамп БД не даёт войти, сам токен есть лишь в cookie.
  tokenHash  String   @unique @map("token_hash")
  telegramId BigInt   @map("telegram_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  @@map("admin_sessions")
}

enum PaymentPurpose {
  /// Одиночная регистрация на старт.
  REGISTRATION
  /// Абонемент на сезон: один счёт на все старты.
  SEASON_PASS
}

enum PaymentState {
  /// Строка создана, счёт в Kaspi ещё не выставлен (или запрос не дошёл).
  CREATED
  /// Счёт выставлен, ждём оплату в приложении Kaspi.
  PENDING
  PAID
  /// Счёт отменён (участником в Kaspi или нами).
  CANCELLED
  /// Время на оплату вышло — место освобождено.
  EXPIRED
  /// Счёт не удалось выставить: номер без Kaspi, ошибка ApiPay и т.п.
  FAILED
}

/// Попытка оплаты через ApiPay (счёт в Kaspi по номеру телефона).
///
/// Одна регистрация или абонемент может иметь несколько попыток: участник
/// не оплатил вовремя и пробует снова. Решает только последняя активная, но
/// старые строки остаются — по ним видно, что происходило со счётом.
model Payment {
  id                Int            @id @default(autoincrement())
  userId            Int            @map("user_id")
  purpose           PaymentPurpose
  registrationId    Int?           @map("registration_id")
  seasonPassId      Int?           @map("season_pass_id")
  /// Сумма в тенге, только целые: Kaspi не принимает тиыны в счёте по номеру.
  amount            Decimal        @db.Decimal(10, 2)
  /// Номер в формате ApiPay: 8XXXXXXXXXX.
  phone             String
  state             PaymentState   @default(CREATED)
  /// id счёта в ApiPay. Уникален: вебхук находит платёж по нему.
  providerInvoiceId Int?           @unique @map("provider_invoice_id")
  /// Последний сырой статус из ApiPay — для разбора без логов.
  providerStatus    String?        @map("provider_status")
  error             String?
  /// До какого момента держим место за участником.
  expiresAt         DateTime       @map("expires_at")
  paidAt            DateTime?      @map("paid_at")
  /// Цена до скидки и скидка по промокоду; amount — итог к оплате.
  baseAmount        Decimal?       @map("base_amount") @db.Decimal(10, 2)
  discount          Decimal        @default(0) @db.Decimal(10, 2)
  promoCodeId       Int?           @map("promo_code_id")
  /// Сколько вернули по счёту в ApiPay (total_refunded из вебхука invoice.refunded).
  refundedAmount    Decimal        @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  /// Когда последний раз спрашивали статус у ApiPay (ограничиваем частоту опроса).
  checkedAt         DateTime?      @map("checked_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration Registration?     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  seasonPass   SeasonPass?       @relation(fields: [seasonPassId], references: [id], onDelete: Cascade)
  refunds      Refund[]
  promoCode    PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  redemptions  PromoRedemption[]

  @@index([state, expiresAt])
  @@index([registrationId])
  @@index([seasonPassId])
  @@map("payments")
}

enum LegalDocumentKind {
  /// Публичная оферта (правила участия) — legal/oferta.md.
  OFERTA
  /// Политика обработки персональных данных — legal/privacy.md.
  PRIVACY
  /// Обещание участника 16–17 лет принести письменное согласие родителя или
  /// законного представителя. «Документ» — сам текст галочки (lib/legal).
  PARENTAL_CONSENT
}

/// Редакция юридического документа: точный текст, под которым участник ставит
/// галочку. Сервер при запуске сохраняет сюда текущий текст из legal/*.md, если
/// такой редакции ещё нет, — так по согласию всегда можно показать, какой
/// именно текст человек принял. Записи не меняются и не удаляются.
model LegalDocument {
  id        Int               @id @default(autoincrement())
  kind      LegalDocumentKind
  /// sha256 текста (первые 16 hex-символов). Любая правка текста — новая редакция.
  version   String
  /// Строка «Редакция от …» из самого текста — для людей; различает редакции version.
  edition   String
  content   String
  createdAt DateTime          @default(now()) @map("created_at")

  consents Consent[]

  @@unique([kind, version])
  @@map("legal_documents")
}

/// Согласие участника с одним документом при регистрации на старт или при
/// оформлении абонемента: кто, с какой редакцией, когда. По строке на документ.
/// Регистрацию или абонемент могут удалить (тестовые записи) — согласие при
/// этом остаётся: это след того, что человек его давал.
model Consent {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  documentId     Int      @map("document_id")
  registrationId Int?     @map("registration_id")
  seasonPassId   Int?     @map("season_pass_id")
  acceptedAt     DateTime @default(now()) @map("accepted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  seasonPass   SeasonPass?   @relation(fields: [seasonPassId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([registrationId])
  @@index([seasonPassId])
  @@map("consents")
}

/// Подписка «Узнать об открытии регистрации». Подписываются через бота (кнопка
/// на сайте → /start notify-<slug>, или кнопка в самом боте) или кнопкой в Mini
/// App. Отдельно от User: подписаться можно, ни разу не открыв приложение.
/// Рассылку «регистрация открыта» запускает администратор (lib/openingSubscribers).
model OpeningSubscriber {
  id             Int       @id @default(autoincrement())
  telegramId     BigInt    @unique @map("telegram_id")
  firstName      String?   @map("first_name")
  username       String?
  /// Откуда пришёл: «notify-<slug>» (сайт), «bot» (кнопка в боте), «app» (Mini App).
  source         String?
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  /// Отписался командой /stop — рассылка его пропускает; новая подписка обнуляет.
  unsubscribedAt DateTime? @map("unsubscribed_at")
  /// Когда отправили «регистрация открыта». Повторно не отправляем.
  notifiedAt     DateTime? @map("notified_at")
  /// Итог отправки: SENT, BLOCKED (бот заблокирован) или FAILED.
  notifyStatus   String?   @map("notify_status")
  notifyError    String?   @map("notify_error")

  @@map("opening_subscribers")
}

/// Кто писал боту (/start, кнопка, любое сообщение) — им можно писать первыми.
/// Аудитория рассылки «новый старт». /stop — отписка от всех рассылок бота,
/// повторный /start возвращает. blockedAt — бот заблокирован (узнали при
/// отправке): больше не пишем, пока человек сам не напишет боту.
model BotContact {
  id          Int       @id @default(autoincrement())
  telegramId  BigInt    @unique @map("telegram_id")
  firstName   String?   @map("first_name")
  username    String?
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  stoppedAt   DateTime? @map("stopped_at")
  blockedAt   DateTime? @map("blocked_at")

  @@map("bot_contacts")
}

/// Сообщение «новый старт» человеку — одно на старт: строка на пару
/// (старт, получатель). FAILED повторяется при следующем запуске рассылки.
model RaceAnnouncement {
  id         Int      @id @default(autoincrement())
  eventId    Int      @map("event_id")
  telegramId BigInt   @map("telegram_id")
  status     String // SENT / BLOCKED / FAILED
  error      String?
  sentAt     DateTime @default(now()) @map("sent_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, telegramId])
  @@map("race_announcements")
}

/// Журнал изменений из админки: кто (telegram_id администратора), когда и что
/// было → что стало. Ссылки — простыми числами, без внешних ключей: запись
/// журнала должна пережить удаление участника или старта.
model AdminAuditLog {
  id              Int      @id @default(autoincrement())
  adminTelegramId BigInt   @map("admin_telegram_id")
  /// participant.update / participant.create / registration.status
  action          String
  eventId         Int?     @map("event_id")
  registrationId  Int?     @map("registration_id")
  userId          Int?     @map("user_id")
  /// Кого касается — «Иванов Иван», чтобы журнал читался без джойнов.
  subject         String
  /// { поле: [было, стало] }
  changes         Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([eventId, createdAt])
  @@map("admin_audit_log")
}

enum RefundSource {
  /// Оформлен в админке («Оформить возврат»); деньги владелец возвращает сам в ApiPay/Kaspi.
  ADMIN
  /// Пришёл вебхук invoice.refunded, а в админке возврат ещё не отмечали.
  APIPAY
}

/// Возврат стартового взноса (оферта, п. 5.1 и 5.3). Одна строка — один этап:
/// для абонемента «целиком» — по строке на каждый оставшийся старт.
model Refund {
  id               Int          @id @default(autoincrement())
  userId           Int          @map("user_id")
  paymentId        Int?         @map("payment_id")
  /// Регистрация на старт (у абонемента — регистрация этапа).
  registrationId   Int?         @map("registration_id")
  seasonPassId     Int?         @map("season_pass_id")
  eventId          Int?         @map("event_id")
  /// 100 / 50 / 0; null — сумма пришла из ApiPay, процент не выбирали.
  percent          Int?
  amount           Decimal      @db.Decimal(10, 2)
  source           RefundSource
  adminTelegramId  BigInt?      @map("admin_telegram_id")
  /// id возврата в ApiPay, когда пришёл вебхук: по нему не учитываем дважды.
  providerRefundId Int?         @unique @map("provider_refund_id")
  confirmedAt      DateTime?    @map("confirmed_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  seasonPass   SeasonPass?   @relation(fields: [seasonPassId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([registrationId])
  @@map("refunds")
}

/// Поддержка в боте (решение пользователя 2026-10-19, вместо ящика info@):
/// на каком шаге человек — пишет вопрос или заполняет анкету партнёра.
model SupportState {
  telegramId BigInt   @id @map("telegram_id")
  /// question — ждём вопрос; partner — анкета партнёра (step — номер поля).
  mode       String
  step       Int      @default(0)
  /// Ответы анкеты партнёра по мере заполнения.
  data       Json     @default("{}")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("support_states")
}

/// Переписка поддержки. IN — от человека (копия у каждого админа: по
/// admin_chat_id + admin_message_id ответ реплаем находит, кому писать),
/// OUT — ответ админа человеку.
model SupportMessage {
  id             Int      @id @default(autoincrement())
  /// Кому принадлежит переписка — человек, который спрашивал.
  telegramId     BigInt   @map("telegram_id")
  direction      String
  /// question / partner / followup / reply
  kind           String
  text           String?
  adminChatId    BigInt?  @map("admin_chat_id")
  adminMessageId Int?     @map("admin_message_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([adminChatId, adminMessageId])
  @@index([telegramId, createdAt])
  @@map("support_messages")
}

/// Справочник дистанций: 3 км, 5 км, 10 км и любые новые. Дистанции стартов
/// (event_distances) ссылаются сюда — по справочнику потом фильтруются
/// протоколы, рейтинг и аналитика (решение пользователя 2026-10-21).
model Distance {
  id        Int      @id @default(autoincrement())
  /// «5 км» — как в названии дистанции у старта.
  label     String   @unique
  /// Длина в метрах; null — не удалось понять из названия.
  meters    Int?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  eventDistances EventDistance[]

  @@map("distances")
}

/// Резерв номеров у старта: автоматически не выдаются, только вручную.
model BibReserve {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  bibFrom   Int      @map("bib_from")
  bibTo     Int      @map("bib_to")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("bib_reserves")
}

/// Дата и часы выдачи стартовых пакетов. Начало первого слота — «начало
/// выдачи»: после него возврат по оферте не производится и номер не
/// освобождается. Слотов нет — запасной вариант: за 2 дня до старта.
model PickupSlot {
  id       Int      @id @default(autoincrement())
  eventId  Int      @map("event_id")
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@map("pickup_slots")
}

enum PromoKind {
  PERCENT
  FIXED
}

/// Промокод (решения пользователя 2026-10-21): один раз на человека, общий
/// лимит, срок действия; привязан к старту или (eventId null) ко всей серии —
/// тогда действует и на абонемент. Скидка — до выставления счёта.
model PromoCode {
  id         Int       @id @default(autoincrement())
  /// Хранится в верхнем регистре: «RUN10».
  code       String    @unique
  kind       PromoKind
  /// Процент (1–100) или сумма в тенге.
  value      Int
  /// Сколько раз всего можно использовать; null — без лимита.
  maxUses    Int?      @map("max_uses")
  validFrom  DateTime? @map("valid_from")
  validUntil DateTime? @map("valid_until")
  eventId    Int?      @map("event_id")
  active     Boolean   @default(true)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")

  event       Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments    Payment[]
  redemptions PromoRedemption[]

  @@map("promo_codes")
}

enum PromoRedemptionStatus {
  /// Счёт выставлен, ждём оплату — использование уже засчитано в лимит.
  HELD
  /// Оплачено (или код на 100% — регистрация бесплатная).
  USED
  /// Счёт не оплатили — использование вернулось в лимит.
  RELEASED
}

/// Кто, когда и где использовал промокод.
model PromoRedemption {
  id             Int                   @id @default(autoincrement())
  promoCodeId    Int                   @map("promo_code_id")
  userId         Int                   @map("user_id")
  paymentId      Int?                  @map("payment_id")
  registrationId Int?                  @map("registration_id")
  seasonPassId   Int?                  @map("season_pass_id")
  baseAmount     Decimal               @map("base_amount") @db.Decimal(10, 2)
  discount       Decimal               @db.Decimal(10, 2)
  status         PromoRedemptionStatus @default(HELD)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([promoCodeId, status])
  @@index([userId])
  @@map("promo_redemptions")
}
