generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id         Int       @id @default(autoincrement())
  // Личность из подписанного Telegram initData — основной идентификатор.
  // Nullable только ради legacy-строк, созданных до Mini App: весь новый код
  // (plugins/telegramAuth.ts) заводит пользователя исключительно по нему.
  telegramId BigInt?   @unique @map("telegram_id")
  username   String?
  firstName  String    @map("first_name")
  lastName   String?   @map("last_name")
  // email/age/phone заполняются не при входе, а при регистрации на старт,
  // поэтому опциональны. @unique с email снят: идентификатор теперь telegram_id,
  // и два Telegram-аккаунта вправе указать один и тот же email.
  email      String?
  // Возраст держим рядом с датой рождения, а не вместо неё: он нужен протоколам
  // и возрастным группам, но сам по себе устаревает. Когда известна дата,
  // сервер пересчитывает age из неё, чтобы эти два поля не разошлись.
  age        Int?
  // Только дата, без времени и часового пояса: @db.Date. DateTime здесь сдвинул
  // бы день на границе TZ — 14.12.1999 в Алматы стало бы 13-м в UTC.
  birthDate  DateTime? @map("birth_date") @db.Date
  phone      String?
  // Пол из формы регистрации — подставляется в следующую, как дата рождения.
  // Пригодится и для зачёта «среди мужчин/женщин». Nullable: у записей,
  // сделанных до этого поля, пола нет.
  gender     Gender?
  createdAt  DateTime  @default(now()) @map("created_at")

  registrations Registration[]
  results       Result[]
  seasonPasses  SeasonPass[]
  notifications Notification[]
  payments      Payment[]
  consents      Consent[]

  @@map("users")
}

model Season {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  events       Event[]
  seasonPasses SeasonPass[]

  @@map("seasons")
}

model Event {
  id                   Int       @id @default(autoincrement())
  title                String
  /// Адрес страницы старта на сайте: /starty/<slug>. Латиницей, с годом
  /// («triatlon-park-astana-2027»), чтобы старты следующих сезонов в тех же
  /// парках получили свои адреса. Пустой — сервер заполнит при запуске (lib/slug).
  slug                 String?   @unique
  date                 DateTime
  /// Когда закрывается регистрация. null — по умолчанию за 7 дней до старта
  /// (lib/eligibility). Задаётся в админке, если нужно иначе.
  registrationClosesAt DateTime? @map("registration_closes_at")
  location             String
  distance             String
  slotsTotal           Int       @map("slots_total")
  slotsTaken           Int       @default(0) @map("slots_taken")
  price                Decimal   @default(0) @db.Decimal(10, 2)
  seasonId             Int?      @map("season_id")
  /// Карта трассы: путь относительно корня API — «/uploads/routes/<файл>».
  /// Не абсолютный URL осознанно: одно и то же значение работает и локально
  /// (localhost:3000), и в проде, где nginx проксирует /api/ на бэкенд.
  /// Сам файл лежит на диске (UPLOAD_DIR, см. lib/routeImages.ts), в БД только
  /// ссылка. null — карты у старта нет, приложение покажет плейсхолдер.
  routeImageUrl        String?   @map("route_image_url")
  /// Программа дня (выдача пакетов, разминка, старт, награждение) — текст
  /// из админки, по строке на пункт. Показывается на странице старта.
  program              String?
  /// Положение о забеге — PDF, загруженный в админке: путь вида
  /// «/uploads/regulations/event-1-a3f9c1d2.pdf» (как у карты трассы).
  regulationsUrl       String?   @map("regulations_url")
  createdAt            DateTime  @default(now()) @map("created_at")

  season        Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  registrations Registration[]
  results       Result[]
  notifications Notification[]

  @@map("events")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Registration {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  eventId       Int           @map("event_id")
  seasonPassId  Int?          @map("season_pass_id")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  qrCode        String?       @map("qr_code")
  registeredAt  DateTime      @default(now()) @map("registered_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seasonPass SeasonPass? @relation(fields: [seasonPassId], references: [id], onDelete: SetNull)
  payments   Payment[]
  consents   Consent[]

  // Один пользователь — одна регистрация на конкретный старт
  @@unique([userId, eventId])
  @@map("registrations")
}

model SeasonPass {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  seasonId      Int           @map("season_id")
  price         Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  registrations Registration[]
  payments      Payment[]
  consents      Consent[]

  // Один абонемент на сезон на пользователя
  @@unique([userId, seasonId])
  @@map("season_passes")
}

model Result {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  eventId    Int      @map("event_id")
  finishTime Int      @map("finish_time") // финишное время в секундах
  place      Int // место в общем зачёте
  recordedAt DateTime @default(now()) @map("recorded_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("results")
}

enum NotificationKind {
  /// Регистрация на один старт принята.
  REGISTERED
  /// Оформлен абонемент на сезон — одно сообщение на все старты.
  SEASON_PASS
  /// Организатор внёс результат.
  RESULT
  /// Напоминание за 3 дня до старта.
  RACE_REMINDER
}

enum NotificationStatus {
  SENT
  /// 403 от Telegram: пользователь не начинал диалог с ботом или заблокировал его.
  /// Не ошибка сервера — писать первым бот не имеет права, и повторы не помогут.
  BLOCKED
  /// Сеть, 5xx, таймаут. Напоминания такие попытки повторят на следующий день.
  FAILED
  /// Отправка выключена (NOTIFY_ENABLED) или у пользователя нет telegram_id.
  SKIPPED
}

/// Журнал уведомлений: и защита от повторной отправки, и единственное место, где
/// видно, до кого сообщение не дошло.
///
/// Ключ (user, event, kind) уникален, а строки пишутся через upsert — то есть
/// здесь лежит последняя попытка каждого вида, а не вся история. Так напоминание
/// нельзя отправить дважды, но повторное сообщение о ИСПРАВЛЕННОМ результате
/// отправить можно: оно просто перезапишет свою строку.
model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  /// null у SEASON_PASS: сообщение относится к сезону, а не к одному старту.
  eventId   Int?               @map("event_id")
  kind      NotificationKind
  status    NotificationStatus
  /// Текст отказа от Telegram — чтобы разбираться, не читая логи pm2.
  error     String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, kind])
  @@map("notifications")
}

/// Сессия администратора в /admin. Пароля в системе нет: личность подтверждает
/// Telegram (Login Widget в браузере или initData внутри Telegram), а дальше
/// живёт эта сессия — её, в отличие от JWT, можно отозвать.
model AdminSession {
  id         Int      @id @default(autoincrement())
  // Только sha256 от токена: дамп БД не даёт войти, сам токен есть лишь в cookie.
  tokenHash  String   @unique @map("token_hash")
  telegramId BigInt   @map("telegram_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  @@map("admin_sessions")
}

enum PaymentPurpose {
  /// Одиночная регистрация на старт.
  REGISTRATION
  /// Абонемент на сезон: один счёт на все старты.
  SEASON_PASS
}

enum PaymentState {
  /// Строка создана, счёт в Kaspi ещё не выставлен (или запрос не дошёл).
  CREATED
  /// Счёт выставлен, ждём оплату в приложении Kaspi.
  PENDING
  PAID
  /// Счёт отменён (участником в Kaspi или нами).
  CANCELLED
  /// Время на оплату вышло — место освобождено.
  EXPIRED
  /// Счёт не удалось выставить: номер без Kaspi, ошибка ApiPay и т.п.
  FAILED
}

/// Попытка оплаты через ApiPay (счёт в Kaspi по номеру телефона).
///
/// Одна регистрация или абонемент может иметь несколько попыток: участник
/// не оплатил вовремя и пробует снова. Решает только последняя активная, но
/// старые строки остаются — по ним видно, что происходило со счётом.
model Payment {
  id                Int            @id @default(autoincrement())
  userId            Int            @map("user_id")
  purpose           PaymentPurpose
  registrationId    Int?           @map("registration_id")
  seasonPassId      Int?           @map("season_pass_id")
  /// Сумма в тенге, только целые: Kaspi не принимает тиыны в счёте по номеру.
  amount            Decimal        @db.Decimal(10, 2)
  /// Номер в формате ApiPay: 8XXXXXXXXXX.
  phone             String
  state             PaymentState   @default(CREATED)
  /// id счёта в ApiPay. Уникален: вебхук находит платёж по нему.
  providerInvoiceId Int?           @unique @map("provider_invoice_id")
  /// Последний сырой статус из ApiPay — для разбора без логов.
  providerStatus    String?        @map("provider_status")
  error             String?
  /// До какого момента держим место за участником.
  expiresAt         DateTime       @map("expires_at")
  paidAt            DateTime?      @map("paid_at")
  /// Когда последний раз спрашивали статус у ApiPay (ограничиваем частоту опроса).
  checkedAt         DateTime?      @map("checked_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  seasonPass   SeasonPass?   @relation(fields: [seasonPassId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
  @@index([registrationId])
  @@index([seasonPassId])
  @@map("payments")
}

enum LegalDocumentKind {
  /// Публичная оферта (правила участия) — legal/oferta.md.
  OFERTA
  /// Политика обработки персональных данных — legal/privacy.md.
  PRIVACY
  /// Обещание участника 16–17 лет принести письменное согласие родителя или
  /// законного представителя. «Документ» — сам текст галочки (lib/legal).
  PARENTAL_CONSENT
}

/// Редакция юридического документа: точный текст, под которым участник ставит
/// галочку. Сервер при запуске сохраняет сюда текущий текст из legal/*.md, если
/// такой редакции ещё нет, — так по согласию всегда можно показать, какой
/// именно текст человек принял. Записи не меняются и не удаляются.
model LegalDocument {
  id        Int               @id @default(autoincrement())
  kind      LegalDocumentKind
  /// sha256 текста (первые 16 hex-символов). Любая правка текста — новая редакция.
  version   String
  /// Строка «Редакция от …» из самого текста — для людей; различает редакции version.
  edition   String
  content   String
  createdAt DateTime          @default(now()) @map("created_at")

  consents Consent[]

  @@unique([kind, version])
  @@map("legal_documents")
}

/// Согласие участника с одним документом при регистрации на старт или при
/// оформлении абонемента: кто, с какой редакцией, когда. По строке на документ.
/// Регистрацию или абонемент могут удалить (тестовые записи) — согласие при
/// этом остаётся: это след того, что человек его давал.
model Consent {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  documentId     Int      @map("document_id")
  registrationId Int?     @map("registration_id")
  seasonPassId   Int?     @map("season_pass_id")
  acceptedAt     DateTime @default(now()) @map("accepted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  seasonPass   SeasonPass?   @relation(fields: [seasonPassId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([registrationId])
  @@index([seasonPassId])
  @@map("consents")
}

/// Подписка «Узнать об открытии регистрации». Подписываются через бота (кнопка
/// на сайте → /start notify-<slug>, или кнопка в самом боте) или кнопкой в Mini
/// App. Отдельно от User: подписаться можно, ни разу не открыв приложение.
/// Рассылку «регистрация открыта» запускает администратор (lib/openingSubscribers).
model OpeningSubscriber {
  id             Int       @id @default(autoincrement())
  telegramId     BigInt    @unique @map("telegram_id")
  firstName      String?   @map("first_name")
  username       String?
  /// Откуда пришёл: «notify-<slug>» (сайт), «bot» (кнопка в боте), «app» (Mini App).
  source         String?
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  /// Отписался командой /stop — рассылка его пропускает; новая подписка обнуляет.
  unsubscribedAt DateTime? @map("unsubscribed_at")
  /// Когда отправили «регистрация открыта». Повторно не отправляем.
  notifiedAt     DateTime? @map("notified_at")
  /// Итог отправки: SENT, BLOCKED (бот заблокирован) или FAILED.
  notifyStatus   String?   @map("notify_status")
  notifyError    String?   @map("notify_error")

  @@map("opening_subscribers")
}
