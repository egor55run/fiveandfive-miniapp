generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt?  @unique @map("telegram_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String   @unique
  age        Int
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")

  registrations Registration[]
  results       Result[]
  seasonPasses  SeasonPass[]

  @@map("users")
}

model Season {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  events       Event[]
  seasonPasses SeasonPass[]

  @@map("seasons")
}

model Event {
  id         Int      @id @default(autoincrement())
  title      String
  date       DateTime
  location   String
  distance   String
  slotsTotal Int      @map("slots_total")
  slotsTaken Int      @default(0) @map("slots_taken")
  price      Decimal  @default(0) @db.Decimal(10, 2)
  seasonId   Int?     @map("season_id")
  createdAt  DateTime @default(now()) @map("created_at")

  season        Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  registrations Registration[]
  results       Result[]

  @@map("events")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Registration {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  eventId       Int           @map("event_id")
  seasonPassId  Int?          @map("season_pass_id")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  qrCode        String?       @map("qr_code")
  registeredAt  DateTime      @default(now()) @map("registered_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seasonPass SeasonPass? @relation(fields: [seasonPassId], references: [id], onDelete: SetNull)

  // Один пользователь — одна регистрация на конкретный старт
  @@unique([userId, eventId])
  @@map("registrations")
}

model SeasonPass {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  seasonId      Int           @map("season_id")
  price         Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  registrations Registration[]

  // Один абонемент на сезон на пользователя
  @@unique([userId, seasonId])
  @@map("season_passes")
}

model Result {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  eventId    Int      @map("event_id")
  finishTime Int      @map("finish_time") // финишное время в секундах
  place      Int // место в общем зачёте
  recordedAt DateTime @default(now()) @map("recorded_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("results")
}
